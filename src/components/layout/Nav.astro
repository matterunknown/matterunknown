---
// Nav.astro — a quiet, static header. No fixed positioning, no scroll effects,
// no hamburger: the links are short enough to wrap on small screens.
//   - "full": wordmark + links (most pages)
//   - "sub":  wordmark + a single back link (essays, tools, archive)
export interface Props {
  variant?: 'full' | 'sub';
  active?: string;       // path to underline in full nav, e.g. "/writing"
  backHref?: string;     // for variant="sub"
  backLabel?: string;
  accent?: 'amber' | 'teal'; // legacy prop, accepted but unused
}

const {
  variant = 'full',
  active = '',
  backHref = '/projects',
  backLabel = 'back',
} = Astro.props as Props;

const links = [
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/now', label: 'Now' },
  { href: '/about', label: 'About' },
  { href: '/subscribe', label: 'Subscribe' },
];
---
<style>
  header {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark span { color: var(--amber); }
  nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  nav a {
    font-size: .92rem;
    color: var(--text-2);
    text-decoration: none;
  }
  nav a:hover { color: var(--amber); }
  nav a.active { color: var(--text); border-bottom: 1px solid var(--amber); }
</style>

<header>
  <a class="wordmark" href="/">matter<span>unknown</span></a>
  {variant === 'full' ? (
    <nav>
      {links.map(link => (
        <a href={link.href} class={active === link.href ? 'active' : ''}>{link.label}</a>
      ))}
    </nav>
  ) : (
    <nav><a href={backHref}>← {backLabel.replace(/^[~←]\s*/, '')}</a></nav>
  )}
</header>
