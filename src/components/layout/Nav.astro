---
// Nav.astro
// Two real variants found in production across 49 pages:
//   - "full": main site pages — logo + 6-link nav + Fund CTA + mobile hamburger (13 pages)
//   - "sub":  tool/experiment pages — logo + single "back" link, no hamburger (10 pages)
//
// This component is the single fix for the "ghost nav" bug that previously had to be
// patched across 12 separate files (inconsistent `@media(max-width:768px)` vs
// `@media (max-width: 768px)` syntax, and no baseline `display:none` outside the query).

export interface Props {
  variant?: 'full' | 'sub';
  active?: string;       // path to mark as active in full nav, e.g. "/writing"
  backHref?: string;     // required for variant="sub"
  backLabel?: string;    // defaults to "~ Lab"
  accent?: 'amber' | 'vessel'; // per-page theme override — 2 "Vessel"-branded pages use teal hover
}

const {
  variant = 'full',
  active = '',
  backHref = '/projects',
  backLabel = '~ Lab',
  accent = 'amber',
} = Astro.props as Props;

const accentVar = accent === 'vessel' ? 'var(--vessel)' : 'var(--amber)';
const accentBorderVar = accent === 'vessel' ? 'var(--vessel-border)' : 'var(--amber-border)';

const links = [
  { href: '/start', label: 'Start Here' },
  { href: '/writing', label: 'Writing' },
  { href: '/studio', label: 'Studio' },
  { href: '/projects', label: 'Lab' },
  { href: '/about', label: 'About' },
  { href: '/fund', label: 'Fund' },
];
---
<style define:vars={{ accentVar, accentBorderVar }}>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    height: var(--nav-h);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 var(--gutter);
    border-bottom: 1px solid transparent;
    transition: all .4s;
  }
  nav.scrolled { border-color: var(--accentBorderVar); background: rgba(9,9,8,.93); backdrop-filter: blur(14px); }
  .nav-logo { font-family: var(--serif); font-size: 1.05rem; color: var(--text); text-decoration: none; }
  .nav-logo span { color: var(--amber); }

  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a {
    font-family: var(--mono); font-size: .68rem; color: var(--text-3);
    letter-spacing: .1em; text-transform: uppercase; transition: color .2s;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--accentVar); }

  .nav-fund {
    font-family: var(--mono); font-size: .62rem; color: var(--text-3);
    letter-spacing: .08em; text-transform: uppercase; transition: color .2s;
  }
  .nav-fund:hover { color: var(--accentVar); }

  .nav-back {
    font-family: var(--mono); font-size: .65rem; color: var(--text-3);
    letter-spacing: .1em; text-transform: uppercase; text-decoration: none;
    transition: color .2s;
  }
  .nav-back:hover { color: var(--accentVar); }

  /* Mobile hamburger — baseline hidden on ALL viewports by default.
     This single rule, defined ONCE, is what the 12-file bug was missing. */
  .nav-hamburger {
    display: none;
    flex-direction: column; justify-content: center; gap: 5px;
    width: 32px; height: 32px; background: none; border: none; cursor: pointer;
    padding: 0;
  }
  .nav-hamburger span {
    display: block; width: 100%; height: 1.5px; background: var(--text);
    transition: transform .25s, opacity .25s;
  }
  .nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-hamburger.open span:nth-child(2) { opacity: 0; }
  .nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .nav-mobile-menu {
    display: none;
    position: fixed; top: var(--nav-h); left: 0; right: 0; bottom: 0; z-index: 199;
    background: rgba(9,9,8,.98); backdrop-filter: blur(14px);
    flex-direction: column; padding: 32px var(--gutter); gap: 4px;
    transform: translateY(-8px); opacity: 0; pointer-events: none;
    transition: transform .3s, opacity .3s;
  }
  .nav-mobile-menu.open {
    display: flex; transform: translateY(0); opacity: 1; pointer-events: auto;
  }
  .nav-mobile-menu a {
    font-family: var(--mono); font-size: .85rem; color: var(--text-2);
    letter-spacing: .06em; text-transform: uppercase; padding: 14px 0;
    border-bottom: 1px solid var(--amber-border);
  }
  .nav-mobile-menu a:hover, .nav-mobile-menu a.active { color: var(--accentVar); }

  @media(max-width: 768px) {
    .nav-links { display: none; }
    .nav-fund { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>

<nav id="site-nav">
  <a class="nav-logo" href="/">matter<span>unknown</span></a>

  {variant === 'full' && (
    <>
      <ul class="nav-links">
        {links.map(link => (
          <li><a href={link.href} class={active === link.href ? 'active' : ''}>{link.label}</a></li>
        ))}
      </ul>
      <a class="nav-fund" href="/fund">Fund the Research</a>
      <button
        class="nav-hamburger"
        id="nav-hamburger"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </>
  )}

  {variant === 'sub' && (
    <a href={backHref} class="nav-back">{backLabel}</a>
  )}
</nav>

{variant === 'full' && (
  <div id="nav-mobile-menu" class="nav-mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu">
    {links.map(link => (
      <a href={link.href} class={active === link.href ? 'active' : ''}>{link.label}</a>
    ))}
  </div>
)}

<script is:inline>
(function () {
  // Scroll shadow — shared by both variants
  window.addEventListener('scroll', () => {
    document.getElementById('site-nav')?.classList.toggle('scrolled', scrollY > 16);
  });

  // Hamburger toggle — proper ARIA state + Escape-to-close + focus trap basics.
  // Replaces the inline onclick="" handler previously duplicated per-page.
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('nav-mobile-menu');
  if (hamburger && mobileMenu) {
    const toggle = (open) => {
      hamburger.classList.toggle('open', open);
      mobileMenu.classList.toggle('open', open);
      hamburger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    hamburger.addEventListener('click', () => {
      toggle(!mobileMenu.classList.contains('open'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) toggle(false);
    });
    mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggle(false)));
  }
})();
</script>
