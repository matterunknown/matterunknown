---
// Footer.astro — institutional three-column footer.
export interface Props {
  copy?: string; // legacy prop, accepted but unused
}
---
<style>
  footer { border-top: 1px solid rgba(232,230,225,.09); margin-top: 6rem; }
  .inner {
    max-width: 1160px; margin: 0 auto;
    padding: 2.6rem clamp(20px, 4vw, 44px) 3.2rem;
    display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px;
  }
  .wm { font-family: var(--serif); font-size: 1.15rem; color: var(--text); }
  .wm span { color: var(--amber); }
  .blurb { margin-top: 10px; font-size: .88rem; color: var(--text-3); max-width: 40ch; }
  .h { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); margin-bottom: 12px; }
  ul { list-style: none; }
  li { margin-bottom: 8px; }
  li a { font-size: .92rem; color: var(--text-2); text-decoration: none; }
  li a:hover { color: var(--amber); }
  .legal {
    max-width: 1160px; margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 44px) 2rem;
    font-size: .78rem; color: var(--text-3);
  }
  @media (max-width: 720px) { .inner { grid-template-columns: 1fr; gap: 28px; } }
</style>

<footer>
  <div class="inner">
    <div>
      <div class="wm">matter<span>unknown</span></div>
      <p class="blurb">Ryan Silver's independent identity research lab. Everything documented in public.</p>
    </div>
    <div>
      <div class="h">Explore</div>
      <ul>
        <li><a href="/writing">Writing</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/model">The framework</a></li>
        <li><a href="/now">Now</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </div>
    <div>
      <div class="h">Follow</div>
      <ul>
        <li><a href="/subscribe">Subscribe</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/archive/vessel">The archive</a></li>
      </ul>
    </div>
  </div>
  <div class="legal">© 2026 Ryan Silver · matterunknown.com</div>
</footer>
