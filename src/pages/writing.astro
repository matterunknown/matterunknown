---
import Base from '../layouts/Base.astro';
---
<Base title="Writing" description="Long-form on AI, security, building, and whatever else is worth thinking about carefully.">
<style>
:root {
  --bg:           #090908;
  --bg-2:         #0d0d0b;
  --bg-3:         #121210;
  --amber:        #c4972a;
  --amber-dim:    rgba(196,151,42,0.12);
  --amber-border: rgba(196,151,42,0.15);
  --vessel:       #7eb8c4;
  --vessel-dim:   rgba(126,184,196,.08);
  --vessel-border:rgba(126,184,196,.12);
  --vessel-glow:  rgba(126,184,196,.04);
  --text:         #e8e6e1;
  --text-2:       #a09c94;
  --text-3:       #5a5752;
  --serif:        'DM Serif Display', Georgia, serif;
  --sans:         'DM Sans', system-ui, sans-serif;
  --mono:         'JetBrains Mono', ui-monospace, monospace;
  --gutter:       clamp(24px, 5vw, 80px);
  --max:          1160px;
  --nav-h:        68px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); font-weight: 300; line-height: 1.7; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
nav { position:fixed;top:0;left:0;right:0;z-index:200;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 var(--gutter);border-bottom:1px solid transparent;transition:all .4s; }
nav.scrolled { border-color:var(--amber-border);background:rgba(9,9,8,.93);backdrop-filter:blur(14px); }
.nav-logo { font-family:var(--serif);font-size:1.05rem;color:var(--text); }
.nav-logo span { color:var(--amber); }
.nav-links { display:flex;gap:32px;list-style:none; }
.nav-links a { font-family:var(--mono);font-size:.68rem;color:var(--text-3);letter-spacing:.1em;text-transform:uppercase;transition:color .2s; }
.nav-links a:hover,.nav-links a.active { color:var(--amber); }
.nav-fund { font-family:var(--mono);font-size:.62rem;color:var(--text-3);letter-spacing:.08em;transition:color .2s; }
.nav-fund:hover { color:var(--vessel); }
.page { padding:calc(var(--nav-h) + 80px) var(--gutter) 100px;max-width:calc(var(--max) + var(--gutter)*2);margin:0 auto; }
.section-label { font-family:var(--mono);font-size:.64rem;color:var(--amber);letter-spacing:.16em;text-transform:uppercase;display:flex;align-items:center;gap:14px;margin-bottom:52px; }
.section-label::before { content:'';width:28px;height:1px;background:var(--amber); }
.section-label::after { content:'';flex:1;height:1px;background:var(--amber-border); }
h1 { font-family:var(--serif);font-size:clamp(2.8rem,6vw,5rem);font-weight:400;line-height:1.06;letter-spacing:-.025em;margin-bottom:14px; }
.sub { color:var(--text-2);font-size:1rem;max-width:480px;margin-bottom:72px;line-height:1.7; }
.writing-list { display:flex;flex-direction:column; }
.writing-row { display:grid;grid-template-columns:72px 1fr auto;align-items:center;gap:36px;padding:28px 0;border-bottom:1px solid var(--amber-border);text-decoration:none;color:inherit;transition:padding-left .3s; }
.writing-row:first-child { border-top:1px solid var(--amber-border); }
.writing-row:hover { padding-left:10px; }
.wr-date { font-family:var(--mono);font-size:.6rem;color:var(--text-3);letter-spacing:.07em; }
.wr-title { font-family:var(--serif);font-size:1.2rem;font-weight:400;letter-spacing:-.01em;transition:color .2s; }
.writing-row:hover .wr-title { color:var(--amber); }
.wr-tag { font-family:var(--mono);font-size:.58rem;color:var(--text-3);letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--amber-border);padding:4px 9px;white-space:nowrap; }
.site-footer { border-top:1px solid var(--amber-border);padding:44px var(--gutter);display:flex;align-items:center;justify-content:space-between; }
.footer-logo { font-family:var(--serif);font-size:.95rem;color:var(--text-3); }
.footer-logo span { color:var(--amber); }
.footer-copy { font-family:var(--mono);font-size:.58rem;color:var(--text-3);letter-spacing:.07em; }

/* Older writing collapsible */
.older-writing { margin-top: 40px; }
.older-writing summary {
  font-family: var(--mono);
  font-size: .62rem;
  color: var(--amber);
  letter-spacing: .14em;
  text-transform: uppercase;
  cursor: pointer;
  padding: 16px 0;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--amber-border);
  user-select: none;
  transition: color .2s;
}
.older-writing summary::-webkit-details-marker { display: none; }
.older-writing summary::before { content: '▸'; font-size: .55rem; transition: transform .2s; }
.older-writing[open] summary::before { transform: rotate(90deg); }
.older-writing summary:hover { color: var(--text-2); }
.older-writing-list { display: flex; flex-direction: column; }
.older-writing-list .writing-row {
  border-color: var(--text-3);
  opacity: .7;
}
.older-writing-list .writing-row:first-child { border-top: 1px solid var(--text-3); }
.older-writing-list .wr-date { color: var(--text-3); }
.older-writing-list .wr-title { color: var(--text-3); }
.older-writing-list .writing-row:hover .wr-title { color: var(--text-2); }
.older-writing-list .wr-tag { color: var(--text-3); border-color: var(--text-3); opacity: .6; }

@media(max-width:768px) { .writing-row { grid-template-columns:1fr;gap:6px; } .wr-date { display:none; }
      .nav-links { display: none; }
      .nav-hamburger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; background: none; border: none; z-index: 300; }
      .nav-hamburger span { display: block; width: 22px; height: 1.5px; background: var(--text-3); transition: all .3s; }
      .nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); background: var(--amber); }
      .nav-hamburger.open span:nth-child(2) { opacity: 0; }
      .nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); background: var(--amber); }
      .nav-mobile-menu { display: none; position: fixed; top: var(--nav-h); left: 0; right: 0; bottom: 0; background: rgba(9,9,8,.97); z-index: 199; flex-direction: column; padding: 40px var(--gutter); gap: 0; overflow-y: auto; }
      .nav-mobile-menu.open { display: flex; }
      .nav-mobile-menu a { font-family: var(--mono); font-size: .9rem; color: var(--text-2); letter-spacing: .1em; text-transform: uppercase; padding: 20px 0; border-bottom: 1px solid var(--amber-border); text-decoration: none; transition: color .2s, padding-left .2s; }
      .nav-mobile-menu a:hover, .nav-mobile-menu a.active { color: var(--amber); padding-left: 8px; }
      .nav-mobile-menu .nav-mobile-fund { margin-top: 32px; border: 1px solid var(--amber-border); padding: 16px 20px; text-align: center; letter-spacing: .12em; border-bottom: 1px solid var(--amber-border); }
      .nav-mobile-menu .nav-mobile-fund:hover { background: var(--amber-dim); } }
</style>

<nav id="nav">
  <a class="nav-logo" href="/">matter<span>unknown</span></a>
  <ul class="nav-links">
    <li><a href="/start">Start Here</a></li>
    <li><a href="/writing" class="active">Writing</a></li>
    <li><a href="/studio">Studio</a></li>
    <li><a href="/projects">Lab</a></li>
    <li><a href="/about">About</a></li>
    <li><a href="/fund">Fund</a></li>
  </ul>
  <a class="nav-fund" href="/fund">Fund the Research</a>
  <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu" onclick="(function(){var h=document.getElementById('nav-hamburger');var m=document.getElementById('nav-mobile-menu');h.classList.toggle('open');m.classList.toggle('open');document.body.style.overflow=m.classList.contains('open')?'hidden':'';})()">
    <span></span><span></span><span></span>
  </button>
</nav>
<div id="nav-mobile-menu" class="nav-mobile-menu">
  <a href="/start">Start Here</a>
  <a href="/writing">Writing</a>
  <a href="/studio">Studio</a>
  <a href="/projects">Lab</a>
  <a href="/about">About</a>
  <a href="/fund">Fund</a>
  <a href="/fund" class="nav-mobile-fund">Fund the Research</a>
</div>

