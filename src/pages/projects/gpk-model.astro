<div class="search-section content" style="padding-top:0;padding-bottom:0;margin-top:40px">
  <div style="font-family:var(--mono);font-size:.62rem;color:var(--gpk-green);letter-spacing:.16em;text-transform:uppercase;display:flex;align-items:center;gap:12px;margin-bottom:20px">
    <span style="width:20px;height:1px;background:var(--gpk-green);display:inline-block"></span>Identify a Card
    <span style="flex:1;height:1px;background:rgba(107,155,58,.2);display:inline-block"></span>
  </div>
  <div class="photo-lookup">
    <label for="gpk-photo-input" class="photo-btn">
      📷 Take or Upload a Photo
      <input id="gpk-photo-input" type="file" accept="image/*" capture="environment" style="display:none" onchange="gpkPhotoLookup(this)">
    </label>
    <p class="photo-hint">Best results on standard (non-foil) cards, well-lit, nameplate visible at the bottom of the card.</p>
    <div id="gpk-photo-results"></div>
  </div>

  <div style="font-family:var(--mono);font-size:.62rem;color:var(--gpk-green);letter-spacing:.16em;text-transform:uppercase;display:flex;align-items:center;gap:12px;margin:32px 0 20px"><span style="width:20px;height:1px;background:var(--gpk-green);display:inline-block"></span>Or Search by Name<span style="flex:1;height:1px;background:rgba(107,155,58,.2);display:inline-block"></span>
  </div>
  <div class="search-bar">
    <input id="gpk-search" class="search-input" type="text" placeholder="Search by card name or set (e.g. Adam Bomb, 1985)..." autocomplete="off">
    <button class="search-btn" onclick="gpkSearch()">SEARCH</button>
  </div>
  <div class="search-filters">
    <span style="font-family:var(--mono);font-size:.55rem;color:#5a5752;align-self:center;letter-spacing:.06em">ERA:</span>
    <div class="filter-chip" data-filter="era" data-val="os_vintage" onclick="gpkToggleFilter(this)">OS Vintage</div>
    <div class="filter-chip" data-filter="era" data-val="2000s_revival" onclick="gpkToggleFilter(this)">2000s Revival</div>
    <div class="filter-chip" data-filter="era" data-val="2010s_modern" onclick="gpkToggleFilter(this)">2010s Modern</div>
    <div class="filter-chip" data-filter="era" data-val="chrome" onclick="gpkToggleFilter(this)">Chrome</div>
    <div class="filter-chip" data-filter="era" data-val="anniversary" onclick="gpkToggleFilter(this)">40th Anniversary</div>
    <span style="font-family:var(--mono);font-size:.55rem;color:#5a5752;align-self:center;letter-spacing:.06em;margin-left:8px">SIGNAL:</span>
    <div class="filter-chip sig-buy" data-filter="signal" data-val="BUY" onclick="gpkToggleFilter(this)">BUY</div>
