<script is:inline>
(function() {
  const btns = document.querySelectorAll('.tab-btn');
  const panes = document.querySelectorAll('.tab-pane');
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      panes.forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      const target = document.getElementById('tab-' + btn.dataset.tab) || document.getElementById('tab-' + btn.dataset.tab + '-wrap');
      if (target) target.classList.add('active');
    });
  });
  const first = document.getElementById('tab-top25');
  if (first) first.classList.add('active');
})();
</script>
<script is:inline>
(function(){
  var _era=null,_sig=null,_timer=null;
  var API="https://automation.houseofidentity.io/api/gpk/search";
  var SC={BUY:"#6b9b3a",WATCH:"#c4972a",HOLD:"#5a5752",SELL:"#c43a3a",SURGE:"#3ac4b8",HYPE:"#9b3ac4"};
  function fmt(p){if(!p||p==0)return"—";return p>=1000?"$"+Math.round(p).toLocaleString():"$"+p.toFixed(2);}
  function render(results,q){
    var el=document.getElementById("gpk-results");
    if(!results||!results.length){el.innerHTML='<div class="search-status">No results for "'+q+'"</div>';return;}
    var h='<div style="margin-top:12px">';
    results.forEach(function(r){
      var sc=SC[r.signal]||"#5a5752";
      var img=r.image_url?'<img class="sr-img" src="'+r.image_url+'" alt="" onerror="this.style.display=\'none\'">':'<div style="width:40px;flex-shrink:0"></div>';
      var setLabel=(r.set_slug||"").replace(/-/g," ").replace(/\b\w/g,function(c){return c.toUpperCase();});
      var scoreLabel=(r.score!=null)?r.score.toFixed(3):"—";
      h+='<div class="sr-row sig-'+r.signal+'" onclick="gpkOpenCard(\''+r.id+'\')" style="cursor:pointer">'+img+
        '<div class="sr-body">'+
        '<div class="sr-name">'+r.raw_title+'</div>'+
        '<div class="sr-meta">'+setLabel+' &middot; '+(r.era||"").replace(/_/g," ")+'</div>'+
        '</div>'+
        '<div class="sr-right">'+
        '<span class="sr-sig" style="color:'+sc+';border-color:'+sc+'44">'+r.signal+'</span>'+
        '<span class="sr-score" style="color:'+sc+'">'+scoreLabel+'</span>'+
        '<div class="sr-price">'+fmt(r.used_price)+'</div>'+
        '</div></div>';
    });
    h+='</div>';
    el.innerHTML=h;
  }
  window.gpkSearch=function(){
    var q=document.getElementById("gpk-search").value.trim();
    if(!q&&!_era&&!_sig){document.getElementById("gpk-results").innerHTML="";return;}
    document.getElementById("gpk-results").innerHTML='<div class="search-status">Searching...</div>';
    var url=API+"?limit=40";
    if(q)url+="&q="+encodeURIComponent(q);
    if(_era)url+="&era="+_era;
    if(_sig)url+="&signal="+_sig;
    fetch(url).then(function(r){return r.json();}).then(function(d){
      render(d.results,q||(_era||"")+(_sig?" "+_sig:""));
    }).catch(function(){
      document.getElementById("gpk-results").innerHTML='<div class="search-status">Search unavailable</div>';
    });
  };
  window.gpkToggleFilter=function(chip){
    var f=chip.dataset.filter,v=chip.dataset.val,was=chip.classList.contains("on");
    document.querySelectorAll('.filter-chip[data-filter="'+f+'"]').forEach(function(c){c.classList.remove("on");});
    if(!was){chip.classList.add("on");if(f==="era")_era=v;else _sig=v;}
    else{if(f==="era")_era=null;else _sig=null;}
    gpkSearch();
  };
  document.getElementById("gpk-search").addEventListener("keydown",function(e){
    if(e.key==="Enter"){gpkSearch();return;}
    clearTimeout(_timer);_timer=setTimeout(gpkSearch,350);
  });

  var LOOKUP_API="https://automation.houseofidentity.io/api/gpk/lookup";
  function renderPhotoResult(data){
    var el=document.getElementById("gpk-photo-results");
    if(data.message){
      el.innerHTML='<div class="search-status">'+data.message+'</div>';
      return;
    }
    if(!data.matches||!data.matches.length){
      el.innerHTML='<div class="search-status">No matches found.</div>';
      return;
    }
    var confNote = data.confidence==="high" ? "" :
      '<div class="photo-hint" style="margin-top:8px">Confidence: '+data.confidence+' — read "'+data.ocr_text+'" from the photo. Verify against the images below.</div>';
    render(data.matches, data.ocr_text||"photo");
    var resultsEl=document.getElementById("gpk-results");
    // Move rendered results into the photo section instead of leaving them
    // duplicated in the name-search results area below.
    el.innerHTML = '<div class="photo-hint">Read from photo: <strong style="color:var(--gpk-green)">'+(data.ocr_text||"—")+'</strong></div>' + confNote + resultsEl.innerHTML;
    resultsEl.innerHTML = "";
  }
  window.gpkPhotoLookup=function(input){
    var file=input.files&&input.files[0];
    if(!file)return;
    var el=document.getElementById("gpk-photo-results");
    el.innerHTML='<div class="search-status">Reading card...</div>';
    fetch(LOOKUP_API,{method:"POST",body:file}).then(function(r){return r.json();}).then(function(d){
      renderPhotoResult(d);
    }).catch(function(){
      el.innerHTML='<div class="search-status">Lookup unavailable — try Search instead.</div>';
    });
  };

  var CARD_API="https://automation.houseofidentity.io/api/gpk/card";
  function fmtDetail(p){if(p==null)return"—";return p>=1000?"$"+Math.round(p).toLocaleString():"$"+p.toFixed(2);}
  function renderCardDetail(c){
    var sc=SC[c.signal]||"#5a5752";
    var setLabel=(c.set_slug||"").replace(/-/g," ").replace(/\b\w/g,function(ch){return ch.toUpperCase();});
    var eraLabel=(c.era||"").replace(/_/g," ");
    var scoreLabel=(c.score!=null)?c.score.toFixed(3):"—";
    var img=c.image_url?'<img class="gpk-detail-img" src="'+c.image_url+'" alt="" onerror="this.style.display=\'none\'">':"";

    var h='<div class="gpk-detail-head">'+img+
      '<div><div class="gpk-detail-title">'+c.raw_title+'</div>'+
      '<div class="gpk-detail-meta">'+setLabel+' &middot; '+eraLabel+' &middot; '+(c.year||"—")+'</div>'+
      '<div class="gpk-detail-signal" style="color:'+sc+';border-color:'+sc+'">'+c.signal+' &middot; '+scoreLabel+'</div>'+
      '</div></div>';

    h+='<div class="gpk-price-grid">'+
      '<div class="gpk-price-cell"><div class="gpk-price-label">Used / Raw</div><div class="gpk-price-val">'+fmtDetail(c.used_price)+'</div></div>'+
      '<div class="gpk-price-cell"><div class="gpk-price-label">CIB</div><div class="gpk-price-val">'+fmtDetail(c.cib_price)+'</div></div>'+
      '<div class="gpk-price-cell"><div class="gpk-price-label">New / Sealed</div><div class="gpk-price-val">'+fmtDetail(c.new_price)+'</div></div>'+
      '</div>';

    if(c.price_history&&c.price_history.length>1){
      var first=c.price_history[0],last=c.price_history[c.price_history.length-1];
      var pct=first.used_price?((last.used_price-first.used_price)/first.used_price*100):0;
      h+='<div class="gpk-section-label">Price History ('+c.price_history.length+' snapshots)</div>'+
        '<div class="photo-hint">'+(pct>=0?"▲":"▼")+' '+Math.abs(pct).toFixed(1)+'% since first tracked ('+fmtDetail(first.used_price)+' → '+fmtDetail(last.used_price)+')</div>';
    } else {
      h+='<div class="gpk-section-label">Price History</div><div class="photo-hint">Not enough data yet — builds up over ~2 weeks of nightly tracking.</div>';
    }

    if(c.related_variants&&c.related_variants.length){
      h+='<div class="gpk-section-label">Other Versions ('+c.related_variants.length+')</div><div class="gpk-related-grid">';
      c.related_variants.forEach(function(v){
        var vImg=v.image_url?'<img src="'+v.image_url+'" alt="" onerror="this.style.display=\'none\'">':"";
        h+='<div class="gpk-related-item" onclick="gpkOpenCard(\''+v.id+'\')">'+vImg+
          '<div class="rv-title">'+(v.variant_tag||"Base")+'</div>'+
          '<div class="rv-price">'+fmtDetail(v.used_price)+'</div></div>';
      });
      h+='</div>';
    }

    document.getElementById("gpk-modal-body").innerHTML=h;
  }
  window.gpkOpenCard=function(cardId){
    if(!cardId)return;
    var overlay=document.getElementById("gpk-modal-overlay");
    document.getElementById("gpk-modal-body").innerHTML='<div class="search-status">Loading...</div>';
    overlay.classList.add("open");
    document.body.style.overflow="hidden";
    fetch(CARD_API+"?id="+encodeURIComponent(cardId)).then(function(r){return r.json();}).then(function(d){
      if(d.error){
        document.getElementById("gpk-modal-body").innerHTML='<div class="search-status">'+d.error+'</div>';
        return;
      }
      renderCardDetail(d);
    }).catch(function(){
      document.getElementById("gpk-modal-body").innerHTML='<div class="search-status">Could not load card details.</div>';
    });
  };
  window.gpkCloseCard=function(){
    document.getElementById("gpk-modal-overlay").classList.remove("open");
    document.body.style.overflow="";
  };
  document.addEventListener("keydown",function(e){
    if(e.key==="Escape")gpkCloseCard();
  });
})();
</script>

