  .card-row:hover { background: #161616; border-color: #2a2a2a; }
  .card-row.sig-BUY { border-left-color: var(--gpk-green); }
  .card-row.sig-WATCH { border-left-color: var(--gold); }
  .card-row.sig-HOLD { border-left-color: #3a3a3a; }
  .card-row.sig-SELL { border-left-color: #c43a3a; }
  .card-row.sig-SURGE { border-left-color: #3ac4b8; }
  .card-row.sig-HYPE { border-left-color: #9b3ac4; }

  .cr-img { width: 40px; height: 56px; flex-shrink: 0; display: flex; align-items: center; }
  .cr-img img { width: 100%; border-radius: 3px; }
  .cr-rank { color: #555; font-size: .7rem; min-width: 24px; text-align: right;
              font-family: monospace; flex-shrink: 0; }
  .cr-body { flex: 1; min-width: 0; }
