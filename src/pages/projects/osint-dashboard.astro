<script is:inline>
window.addEventListener('scroll',()=>{ document.getElementById('nav').classList.toggle('scrolled',scrollY>16); });

// ── Tab switching ──────────────────────────────────────────────────────
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
  });
});

// ── Investigate flow ───────────────────────────────────────────────────
const OSINT_API = 'https://automation.houseofidentity.io/api/osint';
let lastReport = null;

const invQuery   = document.getElementById('inv-query');
const invSubmit  = document.getElementById('inv-submit');
const invStatus  = document.getElementById('inv-status');
const invError   = document.getElementById('inv-error');
const invMeta    = document.getElementById('inv-meta');
const invResults = document.getElementById('inv-results');
const reportActions = document.getElementById('report-actions');
const verifyResultEl = document.getElementById('verify-result');

function agreementLabel(a) {
  return { confirmed: 'Confirmed', partial: 'Partial Agreement', conflicting: 'Conflicting', single_source: 'Single Source' }[a] || a;
}

async function runInvestigation() {
  const q = invQuery.value.trim();
  if (!q) return;

  invSubmit.disabled = true;
  invStatus.classList.add('show');
  invError.classList.remove('show');
  invMeta.classList.remove('show');
  invResults.innerHTML = '';
  reportActions.style.display = 'none';
  verifyResultEl.classList.remove('show');
  lastReport = null;

  try {
    const res = await fetch(`${OSINT_API}/investigate?q=${encodeURIComponent(q)}`);
    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.error || `Request failed (${res.status})`);
    }

    lastReport = data;

    const okSources = data.sources_queried.filter(s => !data.sources_failed.includes(s));
    const failSources = data.sources_failed;
    invMeta.innerHTML = `Queried ${data.sources_queried.length} source(s) for <strong style="color:var(--text-2)">${data.query}</strong> (${data.query_type}) — ` +
      `<span class="ok">${okSources.length} responded</span>` +
      (failSources.length ? `, <span class="fail">${failSources.length} unavailable (${failSources.join(', ')})</span>` : '') +
      ` · ${data.findings.length} findings · signed ${data.generated_at}`;
    invMeta.classList.add('show');

    if (data.correlations.length === 0) {
      invResults.innerHTML = '<p style="color:var(--text-3);font-family:var(--mono);font-size:.8rem;">No findings returned from available sources. Try a different domain or company name.</p>';
    } else {
      invResults.innerHTML = data.correlations.map(group => `
        <div class="corr-group ${group.agreement}">
          <div class="corr-head">
            <span class="corr-fact">${group.fact_type.replace(/_/g, ' ')}</span>
            <span class="corr-badge ${group.agreement}">${agreementLabel(group.agreement)}</span>
          </div>
          ${group.findings.map(f => `
            <div class="corr-finding">
              <span class="src">${f.source}</span>
              <span>${f.value}</span>
            </div>
          `).join('')}
        </div>
      `).join('');
    }

    reportActions.style.display = 'flex';
  } catch (err) {
    invError.textContent = 'Investigation failed: ' + err.message;
    invError.classList.add('show');
  } finally {
    invStatus.classList.remove('show');
    invSubmit.disabled = false;
  }
}

invSubmit.addEventListener('click', runInvestigation);
invQuery.addEventListener('keydown', (e) => { if (e.key === 'Enter') runInvestigation(); });

document.getElementById('download-report').addEventListener('click', () => {
  if (!lastReport) return;
  const blob = new Blob([JSON.stringify(lastReport, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `osint-report-${lastReport.query.replace(/[^a-z0-9]/gi, '_')}-${Date.now()}.json`;
  a.click();
  URL.revokeObjectURL(url);
});

document.getElementById('verify-report').addEventListener('click', async () => {
  if (!lastReport) return;
  try {
    const res = await fetch(`${OSINT_API}/verify`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(lastReport),
    });
    const data = await res.json();
    verifyResultEl.textContent = data.valid
      ? '✓ Signature valid — this report matches what was signed at generation time and has not been altered.'
      : '✕ Signature invalid — this report does not match its signature. Do not treat it as authentic.';
    verifyResultEl.className = 'verify-result show ' + (data.valid ? 'valid' : 'invalid');
  } catch (err) {
    verifyResultEl.textContent = 'Verification request failed: ' + err.message;
    verifyResultEl.className = 'verify-result show invalid';
  }
});

const searchInput = document.getElementById('osint-search');
const cats = document.querySelectorAll('.cat');
const countEl = document.getElementById('search-count');

searchInput.addEventListener('input', () => {
  const q = searchInput.value.trim().toLowerCase();
  let visibleTools = 0;

  cats.forEach(cat => {
    const tools = cat.querySelectorAll('.tool');
    let catHasVisible = false;
    tools.forEach(tool => {
      const name = tool.querySelector('.tool-name').textContent.toLowerCase();
      const catTitle = cat.querySelector('.cat-title').textContent.toLowerCase();
      const catDesc = cat.querySelector('.cat-desc').textContent.toLowerCase();
      const matches = !q || name.includes(q) || catTitle.includes(q) || catDesc.includes(q);
      tool.classList.toggle('hidden', !matches);
      if (matches) { catHasVisible = true; visibleTools++; }
    });
    cat.classList.toggle('hidden', !catHasVisible);
  });

  countEl.textContent = q ? `${visibleTools} tool${visibleTools === 1 ? '' : 's'} matched` : '';
});
</script>
</Base>
