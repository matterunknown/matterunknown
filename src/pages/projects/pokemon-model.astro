<script is:inline>
(function(){
  var _era=null,_sig=null,_timer=null;
  var API="https://automation.houseofidentity.io/api/pokemon/search";
  var SC={BUY:"#4caf50",WATCH:"#c4972a",HOLD:"#5a5752"};
  function fmt(p){if(!p||p==0)return"—";return p>=100?"$"+Math.round(p).toLocaleString():"$"+p.toFixed(2);}
  function render(results,q){
    var el=document.getElementById("search-results");
    if(!results||!results.length){el.innerHTML='<div class="search-status">No results for "'+q+'"</div>';return;}
    var h='<div style="margin-top:12px">';
    results.forEach(function(r){
      var sc=SC[r.signal]||"#5a5752";
      var trend=r.cm_trend?((r.cm_trend>0?"+":"")+r.cm_trend.toFixed(1)+"%"):"—";
      var tc=r.cm_trend>5?"#4caf50":r.cm_trend<-5?"#c45a5a":"#5a5752";
      var img=r.image_small?'<img class="sr-img" src="'+r.image_small+'" alt="">':'<div style="width:40px;flex-shrink:0"></div>';
      h+='<div class="sr-row sig-'+r.signal+'">'+img+
        '<div class="sr-body">'+
        '<div class="sr-name">'+r.name+'</div>'+
        '<div class="sr-meta">'+r.set_name+' &middot; '+r.rarity+'</div>'+
        '</div>'+
        '<div class="sr-right">'+
        '<span class="sr-sig" style="color:'+sc+';border-color:'+sc+'44">'+r.signal+'</span>'+
        '<span class="sr-score" style="color:'+sc+'">'+r.score.toFixed(3)+'</span>'+
        '<div class="sr-price">'+fmt(r.tcg_market)+' <span style="color:'+tc+'">'+trend+'</span></div>'+
        '</div></div>';
    });
    h+='</div>';
    el.innerHTML=h;
  }
  window.pkmSearch=function(){
    var q=document.getElementById("pkm-search").value.trim();
    if(!q&&!_era&&!_sig){document.getElementById("search-results").innerHTML="";return;}
    document.getElementById("search-results").innerHTML='<div class="search-status">Searching...</div>';
    var url=API+"?limit=40";
    if(q)url+="&q="+encodeURIComponent(q);
    if(_era)url+="&era="+_era;
    if(_sig)url+="&signal="+_sig;
    fetch(url).then(function(r){return r.json();}).then(function(d){
      render(d.results,q||(_era||"")+(_sig?" "+_sig:""));
    }).catch(function(){
      document.getElementById("search-results").innerHTML='<div class="search-status">Search unavailable</div>';
    });
  };
  window.pkmChip=function(chip){
    var f=chip.dataset.f,v=chip.dataset.v,was=chip.classList.contains("on");
    document.querySelectorAll('.chip[data-f="'+f+'"]').forEach(function(c){c.classList.remove("on");});
    if(!was){chip.classList.add("on");if(f==="era")_era=v;else _sig=v;}
    else{if(f==="era")_era=null;else _sig=null;}
    pkmSearch();
  };
  document.getElementById("pkm-search").addEventListener("keydown",function(e){
    if(e.key==="Enter"){pkmSearch();return;}
    clearTimeout(_timer);_timer=setTimeout(pkmSearch,350);
  });
})();
</script>

