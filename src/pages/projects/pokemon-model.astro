(function(){
  var _era=null,_sig=null,_timer=null;
  var API="https://api.matterunknown.com/api/pokemon/search";
  var SIG_COLOR={BUY:"#4caf50",WATCH:"#c4972a",HOLD:"#5a5752",AVOID:"#c45a5a"};
  var ERA_LABEL={wizards:"\u{1f3db} Vintage",nintendo:"\u{1f3db} EX Era",dp:"\u{1f3db} DP",bw:"\u2728 BW",xy:"\u2728 XY",sm:"\u2728 SM",swsh:"\u2728 SWSH",sv:"\u2728 SV"};
  function fmt(p){if(!p||p==0)return "\u2014";return p>=100?"$"+Math.round(p).toLocaleString():"$"+p.toFixed(2);}
  function render(results,q){
    var el=document.getElementById("pkm-results");
    if(!results||!results.length){el.innerHTML='<div class="search-status">No results for &ldquo;'+q+'&rdquo;</div>';return;}
    var html="";
    results.forEach(function(r){
      var sc=SIG_COLOR[r.signal]||"#5a5752";
      var trend=r.cm_trend?((r.cm_trend>0?"+":"")+r.cm_trend.toFixed(1)+"%"):"\u2014";
      var tc=r.cm_trend>5?"#4caf50":r.cm_trend<-5?"#c45a5a":"#5a5752";
      var era=ERA_LABEL[r.era]||r.era||"";
      var img=r.image_small?'<img class="sr-img" src="'+r.image_small+'" alt="">':'<div style="width:48px;flex-shrink:0"></div>';
      html+='<div class="search-result-row sig-'+r.signal+'">'+img+
        '<div class="sr-body">'+
        '<div class="sr-name">'+r.name+'</div>'+
        '<div class="sr-meta">'+r.set_name+' &middot; '+r.rarity+' &middot; '+era+'</div>'+
        '</div>'+
        '<div class="sr-right">'+
        '<div class="sr-signal" style="color:'+sc+';border-color:'+sc+'44">'+r.signal+'</div>'+
        '<div class="sr-score" style="color:'+sc+'">'+r.score.toFixed(3)+'</div>'+
        '<div class="sr-price">'+fmt(r.tcg_market)+' &middot; <span style="color:'+tc+'">'+trend+'</span></div>'+
        '</div></div>';
    });
    el.innerHTML=html;
  }
  window.pkmSearch=function(){
    var q=document.getElementById("pkm-search").value.trim();
    if(!q&&!_era&&!_sig){document.getElementById("pkm-results").innerHTML="";return;}
    var el=document.getElementById("pkm-results");
    el.innerHTML='<div class="search-status">Searching...</div>';
    var url=API+"?limit=40";
    if(q) url+="&q="+encodeURIComponent(q);
    if(_era) url+="&era="+_era;
    if(_sig) url+="&signal="+_sig;
    fetch(url).then(function(r){return r.json();}).then(function(d){
      render(d.results,q||(_era||"")+(_sig?" "+_sig:""));
    }).catch(function(){
      el.innerHTML='<div class="search-status">Search unavailable</div>';
    });
  };
  window.pkmToggleFilter=function(chip){
    var f=chip.dataset.filter,v=chip.dataset.val;
    var wasActive=chip.classList.contains("active");
    document.querySelectorAll('.filter-chip[data-filter="'+f+'"]').forEach(function(c){c.classList.remove("active");});
    if(!wasActive){chip.classList.add("active");if(f==="era")_era=v;else _sig=v;}
    else{if(f==="era")_era=null;else _sig=null;}
    pkmSearch();
  };
  document.addEventListener("DOMContentLoaded",function(){
    var inp=document.getElementById("pkm-search");
    inp.addEventListener("keydown",function(e){
      if(e.key==="Enter"){pkmSearch();return;}
      clearTimeout(_timer);_timer=setTimeout(pkmSearch,350);
    });
  });
})();
</script>
