---
import Base from '../../layouts/Base.astro';
---
<Base title="Pokémon Card Model — matterunknown" description="Top 25 Pokémon acquisition targets. Live scores across 17,425 cards — updated daily.">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#090908;--bg-2:#0d0d0b;--bg-3:#121210;
  --amber:#c4972a;--amber-border:rgba(196,151,42,.15);--amber-dim:rgba(196,151,42,.08);
  --text:#e8e6e1;--text-2:#a09c94;--text-3:#5a5752;
  --green:#4caf50;--red:#c45a5a;
  --serif:'DM Serif Display',Georgia,serif;
  --sans:'DM Sans',system-ui,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
  --gutter:clamp(16px,4vw,60px);--max:900px;--nav-h:56px;
}
body{background:var(--bg);color:var(--text);font-family:var(--sans);font-weight:300;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
nav{position:fixed;top:0;left:0;right:0;z-index:200;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 var(--gutter);border-bottom:1px solid transparent;transition:all .3s;}
nav.scrolled{border-color:var(--amber-border);background:rgba(9,9,8,.95);backdrop-filter:blur(12px);}
.nav-logo{font-family:var(--serif);font-size:1rem;color:var(--text);text-decoration:none;}
.nav-logo span{color:var(--amber);}
.nav-back{font-family:var(--mono);font-size:.6rem;color:var(--text-3);letter-spacing:.1em;text-transform:uppercase;text-decoration:none;}
.page{max-width:calc(var(--max) + var(--gutter)*2);margin:0 auto;padding:calc(var(--nav-h) + 32px) var(--gutter) 80px;}
.hdr{margin-bottom:24px;}
.hdr-top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:6px;}
.hdr h1{font-family:var(--serif);font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:400;line-height:1.1;}
.hdr h1 em{font-style:italic;color:var(--amber);}
.hdr-meta{font-family:var(--mono);font-size:.55rem;color:var(--text-3);letter-spacing:.08em;}
.hdr-stats{display:flex;gap:16px;flex-wrap:wrap;margin-top:4px;}
.hdr-stat{font-family:var(--mono);font-size:.6rem;color:var(--text-3);}
.hdr-stat strong{color:var(--text-2);}
/* Tabs */
.tabs{display:flex;gap:2px;margin-bottom:20px;border-bottom:1px solid rgba(255,255,255,.06);}
.tab{font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:10px 18px;cursor:pointer;color:var(--text-3);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .2s;}
.tab:hover{color:var(--text-2);}
.tab.active{color:var(--amber);border-bottom-color:var(--amber);}
.tab-panel{display:none;}
.tab-panel.active{display:block;}
/* Search */
.search-wrap{margin-bottom:20px;}
.search-bar{display:flex;gap:0;margin-bottom:10px;}
.search-input{flex:1;background:var(--bg-2);border:1px solid rgba(196,151,42,.2);border-right:none;padding:11px 16px;font-family:var(--mono);font-size:.72rem;color:var(--text);outline:none;}
.search-input::placeholder{color:var(--text-3);}
.search-input:focus{border-color:rgba(196,151,42,.5);}
.search-btn{background:rgba(196,151,42,.08);border:1px solid rgba(196,151,42,.2);padding:11px 18px;font-family:var(--mono);font-size:.6rem;color:var(--amber);letter-spacing:.1em;cursor:pointer;white-space:nowrap;}
.search-btn:hover{background:rgba(196,151,42,.15);}
.filters{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
.f-label{font-family:var(--mono);font-size:.52rem;color:var(--text-3);letter-spacing:.06em;margin-right:2px;}
.chip{background:transparent;border:1px solid rgba(255,255,255,.07);padding:4px 11px;font-family:var(--mono);font-size:.55rem;color:var(--text-3);letter-spacing:.06em;cursor:pointer;transition:all .15s;white-space:nowrap;}
.chip:hover{border-color:rgba(196,151,42,.3);color:var(--text-2);}
.chip.on{border-color:rgba(196,151,42,.5);color:var(--amber);background:rgba(196,151,42,.07);}
.chip.buy.on{border-color:rgba(76,175,80,.5);color:#4caf50;background:rgba(76,175,80,.07);}
.chip.watch.on{border-color:rgba(196,151,42,.5);color:var(--amber);background:rgba(196,151,42,.07);}
.chip.hold.on{border-color:rgba(90,87,82,.7);color:var(--text-2);background:rgba(90,87,82,.07);}
#search-results .search-status{font-family:var(--mono);font-size:.6rem;color:var(--text-3);padding:20px 0;text-align:center;}
/* Card rows */
.sig-group{margin-bottom:6px;}
.sig-header{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;padding:14px 0 8px;}
.sig-line{width:16px;height:1px;flex-shrink:0;}
.sig-count{margin-left:auto;opacity:.5;}
.card-row{display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--bg-2);border:1px solid rgba(255,255,255,.04);border-left:2px solid transparent;margin-bottom:2px;transition:background .15s;}
.card-row:hover{background:#111110;}
.card-row.sig-BUY{border-left-color:#4caf50;}
.card-row.sig-WATCH{border-left-color:#c4972a;}
.card-row.sig-HOLD{border-left-color:#5a5752;}
.card-row.sig-SELL{border-left-color:#c45a5a;}
.card-row.sig-SURGE{border-left-color:#7eb8c4;}
.card-row.sig-HYPE{border-left-color:#b07fd4;}
.mover-section{margin-bottom:24px;}
.mover-header{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;padding:14px 0 8px;}
.mover-line{width:16px;height:1px;flex-shrink:0;}
.mover-count{margin-left:auto;opacity:.5;}
.cr-rank{font-family:var(--mono);font-size:.52rem;color:var(--text-3);width:22px;flex-shrink:0;text-align:right;}
.cr-body{flex:1;min-width:0;}
.cr-name{font-family:var(--serif);font-size:.95rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;display:flex;align-items:center;gap:6px;}
.cr-set{font-family:var(--mono);font-size:.52rem;color:var(--text-3);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.cr-type{font-family:var(--mono);font-size:.5rem;letter-spacing:.07em;border:1px solid;padding:2px 7px;white-space:nowrap;flex-shrink:0;}
.cr-price{font-family:var(--mono);font-size:.58rem;color:var(--text-2);text-align:right;flex-shrink:0;white-space:nowrap;min-width:70px;}
.cr-trend{display:block;font-size:.5rem;margin-top:1px;}
.cr-signal{font-family:var(--mono);font-size:.52rem;letter-spacing:.1em;border:1px solid;padding:3px 8px;text-align:center;flex-shrink:0;white-space:nowrap;min-width:52px;}
.cr-score{display:block;font-size:.6rem;margin-top:1px;letter-spacing:0;opacity:.8;}
.grade-badge{font-family:var(--mono);font-size:.42rem;letter-spacing:.06em;color:#7eb8c4;border:1px solid rgba(126,184,196,.3);padding:1px 5px;cursor:help;flex-shrink:0;}
/* Search results */
.sr-row{display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--bg-2);border:1px solid rgba(255,255,255,.04);border-left:2px solid transparent;margin-bottom:2px;}
.sr-row.sig-BUY{border-left-color:#4caf50;}
.sr-row.sig-WATCH{border-left-color:#c4972a;}
.sr-row.sig-HOLD{border-left-color:#5a5752;}
.sr-img{width:40px;height:auto;object-fit:contain;flex-shrink:0;opacity:.9;}
.sr-body{flex:1;min-width:0;}
.sr-name{font-family:var(--serif);font-size:.92rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sr-meta{font-family:var(--mono);font-size:.5rem;color:var(--text-3);margin-top:2px;}
.sr-right{text-align:right;flex-shrink:0;}
.sr-sig{font-family:var(--mono);font-size:.5rem;letter-spacing:.1em;border:1px solid;padding:2px 7px;display:inline-block;margin-bottom:2px;}
.sr-score{font-family:var(--mono);font-size:.85rem;display:block;}
.sr-price{font-family:var(--mono);font-size:.5rem;color:var(--text-3);}
/* Section note */
.section-note{font-family:var(--mono);font-size:.56rem;color:var(--text-3);line-height:1.7;margin-bottom:12px;padding:10px 14px;background:var(--bg-2);border-left:2px solid rgba(255,255,255,.06);}
/* Footer */
.footer-strip{margin-top:48px;padding-top:20px;border-top:1px solid rgba(196,151,42,.1);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.footer-strip a{color:var(--amber);text-decoration:none;font-family:var(--mono);font-size:.58rem;}
.footer-note{font-family:var(--mono);font-size:.52rem;color:var(--text-3);}
@media(max-width:600px){
  .cr-type{display:none;}
  .cr-price{min-width:60px;font-size:.52rem;}
  .tab{padding:10px 12px;font-size:.55rem;}
}
@media(min-width:601px){
  .cr-type{display:inline-block;}
}
</style>

