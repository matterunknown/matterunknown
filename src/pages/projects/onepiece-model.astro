</div>

<script>
  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });

  // Search
  const API = 'https://automation.houseofidentity.io/api/onepiece/search';

  async function doSearch() {
    const q      = document.getElementById('search-q').value.trim();
    const set_id = document.getElementById('filter-set').value;
    const signal = document.getElementById('filter-signal').value;
    const rarity = document.getElementById('filter-rarity').value;
    const el     = document.getElementById('search-results');

    if (!q && !set_id && !signal) {
      el.innerHTML = '<p style="color:#555;font-size:.8rem">Enter a search above.</p>';
      return;
    }

    el.innerHTML = '<p style="color:#555;font-size:.8rem">Searching...</p>';

    const params = new URLSearchParams();
    if (q)      params.append('q', q);
    if (set_id) params.append('set_id', set_id);
    if (signal) params.append('signal', signal);
    if (rarity) params.append('rarity', rarity);
    params.append('limit', '30');

    try {
      const resp = await fetch(API + '?' + params.toString());
      const data = await resp.json();
      const results = data.results || [];

      if (!results.length) {
        el.innerHTML = '<p style="color:#555;font-size:.8rem">No results.</p>';
        return;
      }

      const SIG_COLOR = {BUY:'#e8543a',WATCH:'#c4972a',HOLD:'#5a5752',AVOID:'#444'};
      el.innerHTML = results.map(r => {
        const price    = r.price_usd ? '$' + r.price_usd.toFixed(2) : '—';
        const alt      = r.price_alt_usd > 50 ? '<span style="display:block;font-size:.68rem;color:#888">alt $' + r.price_alt_usd.toLocaleString() + '</span>' : '';
        const sig_c    = SIG_COLOR[r.signal] || '#555';
        const img      = r.image_url ? '<img src="' + r.image_url + '" style="width:40px;height:auto;object-fit:contain;flex-shrink:0;opacity:.9">' : '<div style="width:40px;flex-shrink:0"></div>';
        const vbadge   = (r.variant_type && r.variant_type !== 'normal')
          ? '<span style="font-size:.58rem;border-radius:3px;padding:.1rem .3rem;background:#c0392b;color:#fff;font-weight:700;flex-shrink:0">' + r.variant_type.replace('_',' ').toUpperCase() + '</span>' : '';
        return '<div class="card-row" style="border-left-color:' + sig_c + '">' +
          img +
          '<div class="cr-body">' +
            '<div class="cr-name"><span class="cr-name-text">' + r.name + '</span>' + vbadge + '</div>' +
            '<div class="cr-set">' + r.set_name + ' · ' + r.rarity + '</div>' +
          '</div>' +
          '<div class="cr-price">' + price + alt + '</div>' +
          '<div class="cr-signal" style="color:' + sig_c + ';border:1px solid ' + sig_c + '44;border-radius:4px;padding:.2rem .5rem;font-size:.7rem;font-family:monospace;flex-shrink:0">' +
            r.signal + '<span style="display:block;font-size:.6rem;opacity:.7">' + (r.score||0).toFixed(3) + '</span>' +
          '</div>' +
        '</div>';
      }).join('');
    } catch(e) {
      el.innerHTML = '<p style="color:#555;font-size:.8rem">Search unavailable.</p>';
    }
  }

  document.getElementById('search-q').addEventListener('keydown', e => {
    if (e.key === 'Enter') doSearch();
  });
</script>

</BaseLayout>
