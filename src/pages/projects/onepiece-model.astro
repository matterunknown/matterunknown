---
// Auto-generated by rebuild_page.py — 2026-06-28
// One Piece TCG Model v1
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="One Piece Card Market | matterunknown"
  description="Investment signals for One Piece TCG — 875 cards analyzed across 20 sets. BUY, WATCH, and HOLD signals updated daily."
>

<style>
  :root {
    --op-red: #e8543a;
    --op-dark: #1a0a08;
    --gold: #c4972a;
  }
  .page-wrap { max-width: 900px; margin: 0 auto; padding: 1rem; }
  .page-header { margin-bottom: 2rem; }
  .page-title { font-size: 1.6rem; font-weight: 700; color: #f0e8d8; letter-spacing: -.02em; }
  .page-subtitle { color: #888; font-size: .85rem; margin-top: .3rem; }
  .page-meta { display: flex; gap: 1.5rem; margin-top: .8rem; flex-wrap: wrap; }
  .meta-pill { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 20px;
                padding: .2rem .7rem; font-size: .75rem; color: #888; }
  .meta-pill span { color: #f0e8d8; font-weight: 600; }

  /* Tabs */
  .tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .tab-btn { background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 6px;
              padding: .4rem .9rem; font-size: .8rem; color: #888; cursor: pointer;
              font-family: monospace; transition: all .15s; }
  .tab-btn:hover { border-color: #444; color: #ccc; }
  .tab-btn.active { background: #1e0f0a; border-color: var(--op-red); color: var(--op-red); }
  .tab-pane { display: none; }
  .tab-pane.active { display: block; }

  /* Card rows */
  .card-row { display: flex; align-items: center; gap: .75rem; padding: .65rem .8rem;
               background: #111; border: 1px solid #1e1e1e; border-left: 3px solid #333;
               border-radius: 6px; margin-bottom: .4rem; }
  .card-row:hover { background: #161616; border-color: #2a2a2a; }
  .card-row.sig-BUY   { border-left-color: #e8543a; }
  .card-row.sig-WATCH { border-left-color: #c4972a; }
  .card-row.sig-HOLD  { border-left-color: #3a3a3a; }

  .cr-rank { color: #555; font-size: .7rem; min-width: 24px; text-align: right;
              font-family: monospace; flex-shrink: 0; }
  .cr-body { flex: 1; min-width: 0; }
  .cr-name { display: flex; align-items: center; gap: .4rem; font-size: .85rem;
              color: #ddd; font-weight: 500; flex-wrap: wrap; }
  .cr-name-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cr-set  { font-size: .72rem; color: #666; margin-top: .15rem; }
  .cr-type { font-size: .65rem; border: 1px solid; border-radius: 3px;
              padding: .1rem .35rem; flex-shrink: 0; white-space: nowrap; }
  .cr-price { font-size: .82rem; color: #ccc; text-align: right;
               flex-shrink: 0; font-family: monospace; white-space: nowrap; }
  .price-alt { display: block; font-size: .68rem; color: #888; margin-top: .1rem; }
  .cr-signal { font-size: .7rem; border: 1px solid; border-radius: 4px;
                padding: .2rem .5rem; flex-shrink: 0; text-align: center;
                min-width: 52px; font-family: monospace; white-space: nowrap; }
  .cr-score { display: block; font-size: .6rem; opacity: .7; }

  .variant-badge { font-size: .58rem; border-radius: 3px; padding: .1rem .3rem;
                    color: #fff; font-weight: 700; letter-spacing: .03em; flex-shrink: 0; }

  /* Signal groups */
  .sig-group { margin-bottom: 1.5rem; }
  .sig-header { display: flex; align-items: center; gap: .5rem; font-size: .72rem;
                 font-weight: 700; letter-spacing: .08em; margin-bottom: .6rem;
                 text-transform: uppercase; }
  .sig-line { width: 24px; height: 2px; flex-shrink: 0; }
  .sig-count { margin-left: auto; background: #1a1a1a; border: 1px solid #2a2a2a;
                border-radius: 20px; padding: .1rem .5rem; font-size: .7rem;
                color: #666; font-weight: 400; }

  /* Legend */
  .legend { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .leg-bar { flex: 1; min-width: 60px; background: #111; border-radius: 4px;
              padding: .5rem .75rem; border: 1px solid #1e1e1e; }
  .leg-label { font-size: .65rem; color: #666; text-transform: uppercase;
                letter-spacing: .06em; }
  .leg-count { font-size: 1.1rem; font-weight: 700; margin-top: .15rem; }

  /* Search */
  .search-box { display: flex; gap: .5rem; margin-bottom: 1rem; }
  .search-input { flex: 1; background: #111; border: 1px solid #2a2a2a; border-radius: 6px;
                   padding: .5rem .8rem; color: #ddd; font-family: monospace; font-size: .85rem; }
  .search-input:focus { outline: none; border-color: var(--op-red); }
  .search-btn { background: var(--op-red); border: none; border-radius: 6px;
                 padding: .5rem 1rem; color: #fff; cursor: pointer; font-size: .85rem; }
  .search-filters { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .filter-select { background: #111; border: 1px solid #2a2a2a; border-radius: 6px;
                    padding: .35rem .6rem; color: #888; font-size: .75rem;
                    font-family: monospace; cursor: pointer; }
  #search-results .card-row { border-left-color: #333; }

  /* Advisor CTA */
  .advisor-cta { background: linear-gradient(135deg, #1a0a08, #1a1208);
                  border: 1px solid #3a2010; border-radius: 8px;
                  padding: 1.2rem 1.5rem; margin: 1.5rem 0; }
  .advisor-cta h3 { color: var(--op-red); font-size: .9rem; margin: 0 0 .4rem; }
  .advisor-cta p  { color: #888; font-size: .8rem; margin: 0; line-height: 1.5; }

  /* Footer */
  .page-footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #1e1e1e;
                  color: #444; font-size: .72rem; }
</style>

