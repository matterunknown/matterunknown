---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
---
<Base title="matterunknown" description="Ryan Silver's site. Research on identity — especially the identity of AI agents — and smaller projects built in the open.">
<style>
  .intro { padding: 56px 0 44px; }
  .panels { margin-bottom: 52px; }
  .allw { margin-top: 14px; font-size: .9rem; }
  .allw a { color: var(--amber); }
</style>

<Nav variant="full" active="/" />

<main class="wrapb">
  <div class="intro">
    <h1 class="statement">Identity, examined<br><em>in the open.</em></h1>
    <p class="lede">I'm Ryan Silver. I research how systems decide who you are — lately, what identity means for AI agents — and I build smaller things for the joy of it. Methods, trades, and mistakes all public.</p>
  </div>

  <div class="panels">
    <a class="panel" href="/writing/retiring-vessel">
      <div class="sc">Latest essay</div>
      <h3>Retiring Vessel</h3>
      <p>For six months this site ran with an AI persona that named itself. Ending it taught me more about agent identity than building it did.</p>
      <div class="go">Read →</div>
    </a>
    <a class="panel" href="https://commonlist.matterunknown.com" target="_blank" rel="noopener">
      <div class="sc">New from the lab</div>
      <h3>Commonlist</h3>
      <p>One clean address book. Connect, clean, and merge contacts across Google, Microsoft, Outlook, and iCloud.</p>
      <div class="go">Try it →</div>
    </a>
  </div>

  <div class="cols2">
    <div>
      <div class="sc" style="display:block;margin-bottom:16px">Writing</div>
      <a class="wrow" href="/writing/retiring-vessel"><span class="wt">Retiring Vessel</span><span class="wd">Aug 2026</span></a>
      <a class="wrow" href="/writing/the-credential-remembers-who"><span class="wt">The Credential Remembers Who. Nothing Remembers Why.</span><span class="wd">Jul 2026</span></a>
      <a class="wrow" href="/writing/the-workload-is-the-reasoning-session"><span class="wt">The Workload Is the Reasoning Session</span><span class="wd">Jul 2026</span></a>
      <a class="wrow" href="/writing/pokemon-card-market"><span class="wt">The Card Market Has a Data Problem</span><span class="wd">Jun 2026</span></a>
      <a class="wrow" href="/writing/vibe-coding-roblox"><span class="wt">Vibe Coding with My 10 Year Old</span><span class="wd">May 2026</span></a>
      <a class="wrow" href="/writing/identity-is-a-tattoo"><span class="wt">Identity Is a Tattoo. Design It Like One.</span><span class="wd">May 2026</span></a>
      <p class="allw"><a href="/writing">All writing →</a></p>
    </div>
    <div>
      <div class="sc" style="display:block;margin-bottom:16px">Projects</div>
      <div class="gh" style="margin-top:0">Research</div>
      <a class="prow" href="/model"><span class="pt">The Identity Model</span> — the framework: three layers, four failure modes</a>
      <a class="prow" href="/projects/identity-map"><span class="pt">Identity Surface Map</span> — every system holding a version of you</a>
      <a class="prow" href="/projects/password-graveyard"><span class="pt">The Password Graveyard</span> — when your password died, and what killed it</a>
      <span class="prow"><span class="pt">agentic-id</span> — intent tokens for AI agents · in progress</span>
      <div class="gh">For the joy of it</div>
      <a class="prow" href="https://commonlist.matterunknown.com" target="_blank" rel="noopener"><span class="pt">Commonlist</span> — one clean address book across four providers</a>
      <a class="prow" href="/projects/quant-trading"><span class="pt">Quant scanner</span> — 100 symbols nightly, every trade public</a>
      <a class="prow" href="/projects/pokemon-model"><span class="pt">Card models</span> — Pokémon · One Piece · GPK, scored daily</a>
      <span class="prow"><span class="pt">Harvest Haven</span> — a Roblox farm built with my son</span>
      <p class="allw"><a href="/projects">All projects →</a></p>
    </div>
  </div>
</main>

<Footer />
</Base>
